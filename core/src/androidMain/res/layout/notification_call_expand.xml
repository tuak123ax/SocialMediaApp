<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="120dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/image_caller"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="Caller image"
        android:scaleType="centerCrop"
        android:src="@drawable/unknownavatar" />

    <!-- Caller Name -->
    <TextView
        android:id="@+id/text_caller_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Unknown"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Call Status -->
    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="• INCOMING CALL"
        android:textColor="#32C55F"
        android:textSize="12sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Decline -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btn_reject"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_call_reject"
                android:contentDescription="Reject call"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_reject_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="DECLINE"
                android:textColor="#777777"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Accept -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/btn_accept"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_call_accept"
                android:contentDescription="Accept call"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_accept_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ACCEPT"
                android:textColor="#777777"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>