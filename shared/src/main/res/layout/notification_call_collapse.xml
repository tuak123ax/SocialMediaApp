<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Caller Image -->
    <ImageView
        android:id="@+id/image_caller_collapse"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:src="@drawable/unknownavatar"
        android:contentDescription="Caller Image"
        android:scaleType="centerCrop" />

    <!-- Reject Button -->
    <ImageButton
        android:id="@+id/btn_reject_collapse"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_call_reject"
        android:src="@drawable/ic_reject_call"
        android:contentDescription="Reject"
        android:scaleType="center"
        android:padding="10dp" />

    <!-- Accept Button -->
    <ImageButton
        android:id="@+id/btn_accept_collapse"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_toStartOf="@id/btn_reject_collapse"
        android:layout_marginEnd="8dp"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_call_accept"
        android:src="@drawable/ic_accept_call"
        android:contentDescription="Accept"
        android:scaleType="center"
        android:padding="10dp" />

    <!-- Caller Name -->
    <TextView
        android:id="@+id/text_caller_name_collapse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/image_caller_collapse"
        android:layout_toStartOf="@id/btn_accept_collapse"
        android:layout_alignParentTop="true"
        android:layout_marginTop="6dp"
        android:text="Unknown"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Call Status -->
    <TextView
        android:id="@+id/text_call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_caller_name_collapse"
        android:layout_alignStart="@id/text_caller_name_collapse"
        android:text="INCOMING CALL"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#7A8A99"
        android:letterSpacing="0.05"/>

</RelativeLayout>
