<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/call_notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/image_caller_collapse"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Caller image"
        android:scaleType="centerCrop"
        android:src="@drawable/unknownavatar" />

    <!-- Text Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_caller_name_collapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Unknown"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="INCOMING CALL"
            android:textColor="#7A8A99"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Accept -->
    <ImageButton
        android:id="@+id/btn_accept_collapse"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_call_accept"
        android:contentDescription="Accept call"
        android:padding="12dp"
        android:scaleType="center"
        android:src="@drawable/ic_accept_call" />

    <!-- Reject -->
    <ImageButton
        android:id="@+id/btn_reject_collapse"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_call_reject"
        android:contentDescription="Reject call"
        android:padding="12dp"
        android:scaleType="center"
        android:src="@drawable/ic_reject_call" />

</LinearLayout>